<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">

<struts>
    <constant name="struts.devMode" value="false"/>
    <constant name="struts.enable.DynamicMethodInvocation"
              value="false"/>

    <package name="employee"
             namespace="/"
             extends="struts-default">

        <global-results>
            <result name="error">/WEB-INF/error.jsp</result>
        </global-results>

        <action name="employees"
                class="com.employeecrudstrut.controller.EmployeeAction">
            <result name="success">/employees.jsp</result>
        </action>

        <action name="input"
                class="com.employeecrudstrut.controller.EmployeeAction"
                method="input">
            <result name="input">/WEB-INF/employee-form.jsp</result>
        </action>

        <action name="create"
                class="com.employeecrudstrut.controller.EmployeeAction"
                method="create">
            <result name="success" type="redirectAction">
                <param name="actionName">employees</param>
            </result>
            <result name="input">/WEB-INF/employee-form.jsp</result>
        </action>

        <action name="edit"
                class="com.employeecrudstrut.controller.EmployeeAction"
                method="edit">
            <result name="input">/WEB-INF/employee-form.jsp</result>
        </action>

        <action name="update"
                class="com.employeecrudstrut.controller.EmployeeAction"
                method="update">
            <result name="success" type="redirectAction">
                <param name="actionName">employees</param>
            </result>
            <result name="input">/WEB-INF/employee-form.jsp</result>
        </action>

        <action name="delete"
                class="com.employeecrudstrut.controller.EmployeeAction"
                method="delete">
            <result name="success" type="redirectAction">
                <param name="actionName">employees</param>
            </result>
        </action>

    </package>
</struts>
